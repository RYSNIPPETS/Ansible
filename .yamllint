---
# Lint configuration for the playbooks (the YAML analog of .shellcheckrc). These rules
# are kept compatible with ansible-lint's embedded yamllint so both tools agree.
extends: default

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  line-length:
    max: 120
    level: warning
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
